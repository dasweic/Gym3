print("=" * 80)
print("AUDIT SUMMARY")
print("=" * 80)

print(f"PASS : {len(PASS)}")
print(f"WARN : {len(WARN)}")
print(f"FAIL : {len(FAIL)}")
print(f"TOTAL: {total}")

if total:
    score = round((len(PASS) / total) * 100, 2)
else:
    score = 0

print(f"\nBasic pass ratio: {score}%")

if FAIL:
    print("\n" + "=" * 80)
    print("FAILURES")
    print("=" * 80)

    for item in FAIL:
        print(item)

if WARN:
    print("\n" + "=" * 80)
    print("WARNINGS")
    print("=" * 80)

    for item in WARN:
        print(item)

if PASS:
    print("\n" + "=" * 80)
    print("PASSED CHECKS")
    print("=" * 80)

    for item in PASS:
        print(item)

# Generate report file

report_path = ROOT / "GYM_FULL_AUDIT_REPORT.txt"

with open(report_path, "w") as f:
    f.write("GYM MANAGEMENT SAAS FULL AUDIT\n")
    f.write("=" * 80 + "\n")
    f.write(f"Date: {datetime.now()}\n")
    f.write(f"PASS: {len(PASS)}\n")
    f.write(f"WARN: {len(WARN)}\n")
    f.write(f"FAIL: {len(FAIL)}\n")
    f.write(f"TOTAL: {total}\n")
    f.write(f"SCORE: {score}%\n\n")

    for section, items in [
        ("FAILURES", FAIL),
        ("WARNINGS", WARN),
        ("PASSED", PASS),
        ("INFO", INFO),
    ]:
        f.write("\n" + section + "\n")
        f.write("-" * 80 + "\n")

        for item in items:
            f.write(item + "\n")

print("\nReport saved at:")
print(report_path)

print("\nAUDIT COMPLETED")
