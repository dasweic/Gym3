

import os
import sys
import ast
import json
import re
import time
import urllib.request
import urllib.error
import subprocess
from pathlib import Path
from datetime import datetime

ROOT = Path(__file__).resolve().parent
BACKEND = ROOT / "backend"
FRONTEND = ROOT / "frontend"

API = "http://127.0.0.1:8000"
WEB = "http://127.0.0.1:5500"

PASS = []
WARN = []
FAIL = []
INFO = []

def add_result(category, status, message):
    entry = f"[{status}] {category}: {message}"

    if status == "PASS":
        PASS.append(entry)
    elif status == "WARN":
        WARN.append(entry)
    elif status == "FAIL":
        FAIL.append(entry)
    else:
        INFO.append(entry)

    print(entry)

def heading(text):
    print("\n" + "=" * 80)
    print(text)
    print("=" * 80)

def check_file(path, label=None):
    label = label or str(path)

    if path.exists() and path.is_file():
        add_result("FILE", "PASS", f"{label} exists")
        return True

    add_result("FILE", "FAIL", f"{label} missing")
    return False

def check_directory(path, label=None):
    label = label or str(path)

    if path.exists() and path.is_dir():
        add_result("DIRECTORY", "PASS", f"{label} exists")
        return True

    add_result("DIRECTORY", "FAIL", f"{label} missing")
    return False

def read_text(path):
    try:
        return path.read_text(errors="ignore")
    except Exception:
        return ""

def http_request(url, method="GET", data=None, headers=None, timeout=6):
    headers = headers or {}

    if data is not None:
        data = json.dumps(data).encode()
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(
        url,
        data=data,
        headers=headers,
        method=method
    )

    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            body = response.read().decode(errors="ignore")
            return response.status, body, dict(response.headers)

    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="ignore")
        return e.code, body, dict(e.headers)

    except Exception as e:
        return None, str(e), {}

def run_command(command, cwd=None, timeout=15):
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=timeout
        )

        return result.returncode, result.stdout, result.stderr

    except Exception as e:
        return -1, "", str(e)

def safe_relative(path):
    try:
        return str(path.relative_to(ROOT))
    except Exception:
        return str(path)

